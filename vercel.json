{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/quiz.mjs": {
      "maxDuration": 300
    },
    "api/telegram.mjs": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/quiz-cleanup",
      "schedule": "0 0 * * *"
    }
  ]
}
