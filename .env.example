# Add production values to Vercel Project Settings > Environment Variables.
# Connect a private Vercel Blob store to the project for persistent API data.
# For local `vercel dev`, set BLOB_READ_WRITE_TOKEN from that store.
# Quiz AI: set GEMINI_API_KEY (free tier, https://aistudio.google.com/apikey) or OPENAI_API_KEY. Gemini is used when both are set.
GEMINI_API_KEY=
GEMINI_QUIZ_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
SUPADATA_API_KEY=
OPENAI_QUIZ_MODEL=gpt-4.1-mini
CRON_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
